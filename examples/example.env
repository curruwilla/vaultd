# Demo values so `vaultd validate -c examples/config.yaml` runs anywhere.
# Nothing here is a real credential; the age recipient is a public key.
#
#   set -a; . examples/example.env; set +a

VAULTD_AGE_RECIPIENT=age1sek6hu80sp8c3kg06m665nvrk4jglqk4mxeyu7as0dm48jzlh53snmhr00

CF_ACCOUNT_ID=0123456789abcdef0123456789abcdef
R2_ACCESS_KEY_ID=demo-access-key-id
R2_SECRET_ACCESS_KEY=demo-secret-access-key

PROD_PG_DSN=postgres://backup@pg.internal:5432/app?sslmode=require
PROD_MYSQL_DSN=mysql://backup@mysql.internal:3306/app
PROD_MONGO_URI=mongodb://backup@mongo.internal:27017/?replicaSet=rs0
STAGING_PG_ADMIN_DSN=postgres://vaultd@staging-pg.internal:5432/postgres?sslmode=require

OPS_WEBHOOK_URL=https://hooks.example.com/vaultd
OPS_WEBHOOK_SECRET=demo-webhook-secret
VAULTD_UI_TOKEN=demo-ui-token
